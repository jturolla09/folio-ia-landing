{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.folio-ai.app" }],
      "destination": "https://folio-ai.lovable.app/",
      "permanent": false
    },
    {
      "source": "/:path((?!\\.well-known/assetlinks\\.json$).*)",
      "has": [{ "type": "host", "value": "app.folio-ai.app" }],
      "destination": "https://folio-ai.lovable.app/:path*",
      "permanent": false
    },
    { "source": "/auth", "destination": "https://folio-ai.lovable.app/auth", "permanent": false },
    { "source": "/auth/:path((?!callback$).*)", "destination": "https://folio-ai.lovable.app/auth/:path*", "permanent": false },
    { "source": "/reset-password", "destination": "https://folio-ai.lovable.app/reset-password", "permanent": false },
    { "source": "/verify-email", "destination": "https://folio-ai.lovable.app/verify-email", "permanent": false },
    { "source": "/unsubscribe", "destination": "https://folio-ai.lovable.app/unsubscribe", "permanent": false },
    { "source": "/checkout/:path*", "destination": "https://folio-ai.lovable.app/checkout/:path*", "permanent": false },
    { "source": "/.lovable/:path*", "destination": "https://folio-ai.lovable.app/.lovable/:path*", "permanent": false },
    { "source": "/exams", "destination": "https://folio-ai.lovable.app/exams", "permanent": false },
    { "source": "/exams/:path*", "destination": "https://folio-ai.lovable.app/exams/:path*", "permanent": false },
    { "source": "/exam/:path*", "destination": "https://folio-ai.lovable.app/exam/:path*", "permanent": false },
    { "source": "/metrics", "destination": "https://folio-ai.lovable.app/metrics", "permanent": false },
    { "source": "/upload", "destination": "https://folio-ai.lovable.app/upload", "permanent": false },
    { "source": "/settings", "destination": "https://folio-ai.lovable.app/settings", "permanent": false },
    { "source": "/coach", "destination": "https://folio-ai.lovable.app/coach", "permanent": false },
    { "source": "/plans", "destination": "https://folio-ai.lovable.app/plans", "permanent": false },
    { "source": "/help", "destination": "https://folio-ai.lovable.app/help", "permanent": false },
    { "source": "/account", "destination": "https://folio-ai.lovable.app/account", "permanent": false },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms-of-service.html", "permanent": true },
    { "source": "/account-deletion", "destination": "/account-deletion.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/auth/callback",
      "has": [{ "type": "host", "value": "folio-ai.app" }],
      "destination": "/auth/callback.html"
    }
  ]
}
